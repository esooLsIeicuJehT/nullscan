NULLSCAN_MAX_UPLOAD_MB=512
NULLSCAN_UPLOAD_DIR=/data/uploads
NULLSCAN_DB=/data/jobs.db
NULLSCAN_WORKERS=3
NULLSCAN_JOB_TIMEOUT=300
NULLSCAN_RETAIN_HOURS=72
NULLSCAN_API_KEYS=
NULLSCAN_SIGNING_SECRET=
NULLSCAN_REQUIRE_SIG=0
LOG_LEVEL=INFO

# --- free public scanner ---
NULLSCAN_SERVE_WEB=1
NULLSCAN_FREE_SCANS=3
NULLSCAN_FREE_WINDOW_S=86400
# Enable ONLY behind a real proxy (Railway, Cloudflare). X-Forwarded-For is
# caller-controlled; trusting it on a directly-exposed host gives anyone
# unlimited free scans for the price of one header.
NULLSCAN_TRUST_PROXY=1

# --- billing (optional; absent keys disable the endpoints, they don't crash) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NULLSCAN_PUBLIC_URL=https://nullscan.up.railway.app
# Stripe Managed Payments requires a product tax code. Default is SaaS/business.
NULLSCAN_TAX_CODE=txcd_10103001
